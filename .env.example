# GitHub
# Preferred auth for push/remote setup is SSH. If you want HTTPS automation instead,
# use a fine-grained personal access token with repo access.
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_DEFAULT_BRANCH=main
GITHUB_PAT=

# Cloudflare Pages
# Create a token with Cloudflare Pages edit permissions for the target account.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_PAGES_PROJECT_NAME=
CLOUDFLARE_PAGES_BRANCH=main

# Optional deployment details
# Leave empty if you will connect the GitHub repo manually in the Cloudflare dashboard.
CLOUDFLARE_PAGES_DOMAIN=
CLOUDFLARE_PAGES_BUILD_COMMAND=npm run build
CLOUDFLARE_PAGES_OUTPUT_DIR=dist
